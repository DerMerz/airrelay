[submodule "receiver/src/main/cpp/third_party/UxPlay"]
	path = receiver/src/main/cpp/third_party/UxPlay
	url = https://github.com/FDH2/UxPlay.git
	shallow = true
	ignore = dirty
[submodule "receiver/src/main/cpp/third_party/libplist"]
	path = receiver/src/main/cpp/third_party/libplist
	url = https://github.com/libimobiledevice/libplist.git
	shallow = true
[submodule "receiver/src/main/cpp/third_party/openssl-cmake"]
	path = receiver/src/main/cpp/third_party/openssl-cmake
	url = https://github.com/viaduck/openssl-cmake.git
	shallow = true
[submodule "receiver/src/main/cpp/third_party/ffmpeg"]
