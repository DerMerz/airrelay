	url = https://github.com/FFmpeg/FFmpeg.git
	shallow = true
[submodule "receiver/src/main/cpp/third_party/oboe"]
	path = receiver/src/main/cpp/third_party/oboe
	url = https://github.com/google/oboe.git
	shallow = true
