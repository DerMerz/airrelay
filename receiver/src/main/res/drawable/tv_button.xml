<?xml version="1.0" encoding="utf-8"?>
<!-- The text colour is the same in every state; focus is shown by the ring only, so text and
     background can never fall out of step (white pill without a label, 03.11.2026). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="28dp" />
            <solid android:color="@color/chip_fill" />
            <stroke android:width="3dp" android:color="@color/focus_ring" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <solid android:color="@color/chip_fill" />
        </shape>
    </item>
</selector>
