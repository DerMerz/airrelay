<?xml version="1.0" encoding="utf-8"?>
<!-- Designed for the Fire TV canvas of 960x540 dp. Only D-pad focusable controls. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- waiting layout: subscription offer (only without subscription), status, name, how-to -->
    <LinearLayout
        android:id="@+id/waiting_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="72dp"
        android:paddingTop="32dp"
        android:paddingEnd="56dp"
        android:paddingBottom="96dp">

    <LinearLayout
        android:id="@+id/offer_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/offer_box"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/attempt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/attempt_refused"
            android:textColor="@color/warning"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/offer_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            tools:text="7 Tage gratis testen" />

        <TextView
            android:id="@+id/offer_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:maxWidth="620dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            tools:text="@string/offer_renewal" />

        <LinearLayout
            android:id="@+id/offer_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/option_yearly"
                style="@style/OfferOption">

                <TextView
                    style="@style/OfferOptionTitle"
                    android:text="@string/term_yearly" />

                <TextView
                    android:id="@+id/option_yearly_price"
                    style="@style/OfferOptionDetail"
                    tools:text="7 Tage gratis, dann 14,99 €/Jahr" />

                <TextView
                    android:id="@+id/option_yearly_compare"
                    style="@style/OfferOptionDetail"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="15sp"
                    android:textColor="@color/offer_option_compare"
                    tools:text="1,25 € im Monat, 49 % günstiger" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option_monthly"
                style="@style/OfferOption"
                android:layout_marginStart="12dp">

                <TextView
                    style="@style/OfferOptionTitle"
                    android:text="@string/term_monthly" />

                <TextView
                    android:id="@+id/option_monthly_price"
                    style="@style/OfferOptionDetail"
                    tools:text="7 Tage gratis, dann 2,49 €/Monat" />
            </LinearLayout>

            <TextView
                android:id="@+id/restore_button"
                style="@style/TvButton"
                android:layout_marginStart="12dp"
                android:nextFocusRight="@id/restore_button"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/restore"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/offer_retry"
            style="@style/TvButton"
            android:layout_marginTop="14dp"
            android:text="@string/retry"
            android:visibility="gone" />

        <TextView
            android:id="@+id/offer_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/status_label"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="Der Kauf wurde abgebrochen. Es wurde nichts berechnet." />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/status_label"
                android:textSize="18sp"
                tools:text="Bereit zum Spiegeln" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:breakStrategy="balanced"
                android:fontFamily="sans-serif-medium"
                android:hyphenationFrequency="none"
                android:textColor="@color/text_primary"
                android:textSize="60sp"
                tools:text="Kevins 2. FireTVStick" />

            <LinearLayout
                android:id="@+id/steps_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView style="@style/StepNumber" android:text="1" tools:ignore="HardcodedText" />

                    <TextView style="@style/StepText" android:text="@string/step_control_center" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/step_row2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView style="@style/StepNumber" android:text="2" tools:ignore="HardcodedText" />

                    <TextView style="@style/StepText" android:text="@string/step_mirroring" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/step_row3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView style="@style/StepNumber" android:text="3" tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/step3"
                        style="@style/StepText"
                        tools:text="Wähle „Kevins 2. FireTVStick“ aus." />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/body_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="24sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/error_actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/retry_button"
                    style="@style/TvButton"
                    android:text="@string/retry" />

                <TextView
                    android:id="@+id/network_button"
                    style="@style/TvButton"
                    android:layout_marginStart="16dp"
                    android:text="@string/network_settings" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/hero_image"
            android:layout_width="300dp"
            android:layout_height="217dp"
            android:layout_marginStart="32dp"
            android:importantForAccessibility="no"
            android:src="@drawable/hero" />
    </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/ip_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="72dp"
        android:layout_marginBottom="40dp"
        android:textColor="@color/text_tertiary"
        android:textSize="16sp"
        tools:text="IP-Adresse 192.168.8.11" />

    <!-- Wi-Fi hint on the waiting screen (T-31b): one line between the how-to and the IP -->
    <TextView
        android:id="@+id/wifi_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="72dp"
        android:layout_marginBottom="68dp"
        android:maxWidth="640dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:focusable="false"
        android:textColor="@color/warning"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="@string/wifi_weak" />

    <TextView
        android:id="@+id/licenses_button"
        style="@style/TvButton"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="28dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/licenses"
        android:textSize="16sp" />

    <!-- full-screen picture -->
    <FrameLayout
        android:id="@+id/video_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <SurfaceView
            android:id="@+id/video_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/connecting_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/connecting"
            android:textColor="@color/text_secondary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/stop_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="48dp"
            android:background="@drawable/pill"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp"
            android:text="@string/stop_hint"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:visibility="gone" />

        <!-- Wi-Fi hint beside a portrait picture (T-31b), placed in the free strip by code,
             never over the picture -->
        <TextView
            android:id="@+id/wifi_hint_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:maxLines="5"
            android:ellipsize="end"
            android:focusable="false"
            android:textColor="@color/warning"
            android:textSize="20sp"
            android:visibility="gone"
            tools:text="@string/wifi_weak" />
    </FrameLayout>

    <!-- licences, opened from the waiting screen -->
    <ScrollView
        android:id="@+id/licenses_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_top"
        android:clipToPadding="false"
        android:focusable="true"
        android:paddingStart="72dp"
        android:paddingTop="40dp"
        android:paddingEnd="72dp"
        android:paddingBottom="40dp"
        android:scrollbarStyle="outsideOverlay"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/licenses"
                android:textColor="@color/text_primary"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/licenses_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
